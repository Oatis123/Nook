{
  "name": "moss-bookish-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#161711",
    "editor.foreground": "#EEECE0"
  },
  "tokenColors": [
    {
      "name": "text",
      "scope": ["source", "variable", "variable.parameter", "meta.embedded"],
      "settings": {
        "foreground": "#EEECE0"
      }
    },
    {
      "name": "comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8E8D80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "punctuation",
      "scope": ["punctuation", "keyword.operator", "meta.brace"],
      "settings": {
        "foreground": "#8E8D80"
      }
    },
    {
      "name": "ink kw",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control.import",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#D6A2DE",
        "fontStyle": ""
      }
    },
    {
      "name": "ink fn",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "meta.function-call entity.name.function",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#88BCF6",
        "fontStyle": ""
      }
    },
    {
      "name": "ink type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "entity.name.namespace",
        "entity.name.type.module",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#CEB66A",
        "fontStyle": ""
      }
    },
    {
      "name": "ink str",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "#A5C47E",
        "fontStyle": ""
      }
    },
    {
      "name": "ink num",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#EBA57B",
        "fontStyle": ""
      }
    },
    {
      "name": "ink prop",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.type.property-name.json",
        "entity.name.tag",
        "entity.name.tag.yaml",
        "meta.attribute.python variable.other"
      ],
      "settings": {
        "foreground": "#F19D9F",
        "fontStyle": ""
      }
    },
    {
      "name": "ink bi",
      "scope": [
        "support.function.builtin",
        "support.function.magic",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#61CCC3",
        "fontStyle": ""
      }
    },
    {
      "name": "ink bi italic",
      "scope": ["variable.language", "variable.parameter.function.language.special.self"],
      "settings": {
        "foreground": "#61CCC3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#E5A04B",
        "fontStyle": "underline"
      }
    },
    {
      "name": "markdown heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#CEB66A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#A6B96A"
      }
    },
    {
      "name": "markdown inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": {
        "foreground": "#A5C47E"
      }
    },
    {
      "name": "markdown emphasis",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "markdown bold",
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "diff inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#A6B96A"
      }
    },
    {
      "name": "diff deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#E5A04B"
      }
    }
  ]
}
