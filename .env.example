APP_NAME=Nook
PUBLIC_URL=http://localhost:8080
# Required in production, at least 32 bytes — generate with: openssl rand -hex 32
# The API refuses to start with an empty, default or short key.
SECRET_KEY=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_MODE=polling
ADMIN_USERNAME=
ADMIN_PASSWORD=
MAX_UPLOAD_MB=25
MAX_IMPORT_MB=500
WEB_PORT=8080
# Address (CIDR) of a TLS reverse proxy in front of `web` whose X-Forwarded-For nginx
# should trust for the client IP. Leave the default when nothing sits in front.
TRUSTED_PROXY_CIDR=127.0.0.1/32
