# Auto detect text files and perform LF normalization
* text=auto

# Always LF, even in a Windows checkout with core.autocrlf=true: these run or are read
# on Linux (inside the images or on the Docker host). A CRLF shebang becomes
# "#!/bin/sh\r", and the container dies with "exec ... No such file or directory".
*.sh        text eol=lf
Dockerfile  text eol=lf
Caddyfile   text eol=lf
*.conf      text eol=lf
*.template  text eol=lf
