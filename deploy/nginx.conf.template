server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size ${MAX_UPLOAD_MB}m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml font/woff2;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    # script-src needs 'wasm-unsafe-eval' (not the much broader 'unsafe-eval') for the
    # markdown preview's syntax highlighter (shiki), which compiles a WebAssembly oniguruma
    # regex engine on the client. font-src needs data: because @fontsource's per-subset
    # woff2 files are small enough that Vite inlines many of them as data: URIs in the
    # built CSS instead of emitting separate font files.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location /api/ {
        # No trailing slash on the proxy_pass URL (and no URI part) — this forwards the
        # original request path unchanged (e.g. /api/v1/auth/login), matching the
        # backend's actual mount point (api_router = APIRouter(prefix="/api/v1")).
        # A trailing slash here would strip the /api/ location prefix before forwarding,
        # sending the backend /v1/auth/login instead, which matches no route (404).
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /mcp {
        proxy_pass http://api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Streamable HTTP (app/mcp/) can hold a response open as server-sent events —
        # buffering or the default short read timeout would cut that stream, and a
        # long-running tool call, off early.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # Hashed build assets: safe to cache aggressively.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri /index.html;
    }
}
